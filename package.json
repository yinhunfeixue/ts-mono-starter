{
  "name": "ts-mono-starter",
  "version": "1.0.0",
  "description": "A TypeScript monorepo starter with Lerna, pnpm workspace, and dual module format support",
  "type": "module",
  "private": true,
  "workspaces": [
    "packages/*",
    "test"
  ],
  "scripts": {
    "build": "lerna run build --stream",
    "dev": "lerna run dev --stream",
    "version": "lerna version --no-push --exact --force-publish",
    "clean": "lerna clean -y && rimraf node_modules",
    "depcheck": "depcheck && lerna exec depcheck",
    "prebuild": "npm run depcheck",
    "test": "npm run test --prefix test",
    "lint": "eslint .",
    "newlib": "tsx ./scripts/createLib.ts",
    "beta": "npm run build && npm run version && lerna publish from-package --dist-tag=beta",
    "prepare": "husky"
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "@babel/preset-typescript": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-babel": "^7.1.0",
    "@types/adm-zip": "^0.5.8",
    "@types/node": "^26.2.0",
    "adm-zip": "^0.6.0",
    "chokidar": "^5.0.0",
    "depcheck": "^1.4.7",
    "eslint": "^10.8.1",
    "globals": "^17.9.0",
    "husky": "^9.1.7",
    "lerna": "^10.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "tsdown": "^0.22.14",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss}": [
      "prettier --write"
    ]
  }
}
